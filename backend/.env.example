NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated allowed origins. The Android app (Capacitor) uses https://localhost.
CORS_ORIGINS=https://localhost,http://localhost:5173
# Supabase project URL and publishable (anon) key. Required for authenticated routes such as /me.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# OpenRouter API key (server-side only; create one at openrouter.ai/keys). Enables /ai/models and /ai/chat.
OPENROUTER_API_KEY=
OPENROUTER_REFERER=
# Max AI chat requests per user per 10 minutes.
AI_RATE_LIMIT=30
